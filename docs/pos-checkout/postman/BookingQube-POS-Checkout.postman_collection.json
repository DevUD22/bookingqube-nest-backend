            },
            "description": "POST /pos/online-tickets/:id/use — optional rfids[]. Syncs attendance."
          },
          "response": []
        }
      ]
    },
    {
      "name": "06 POS Daily Closing (Shift)",
      "description": "Agent sales report + close shift (creates DailyClosing). Blocked after close.",
      "item": [
        {
          "name": "Get Shift Report",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "try {",
                  "  const d = pm.response.json().data;",
                  "  if (d && d.closing && d.closing.id) {",
                  "    pm.environment.set('dailyClosingId', d.closing.id);",
                  "  }",
                  "} catch (e) {}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pos/shift?date={{closingDate}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pos",
                "shift"
              ],
              "query": [
                {
                  "key": "date",
                  "value": "{{closingDate}}"
                }
              ]
            },
            "description": "GET /pos/shift — expected cash/card/ticket/addon totals for date (defaults to today Qatar). This is the POS agent sales report."
          },
          "response": []
        },
        {
          "name": "Close Shift (Daily Closing)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "try {",
                  "  const d = pm.response.json().data;",
                  "  if (d && d.closing && d.closing.id) {",
                  "    pm.environment.set('dailyClosingId', d.closing.id);",
                  "  }",
                  "} catch (e) {}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"{{closingDate}}\",\n  \"declared_cash\": 100,\n  \"declared_card\": 50,\n  \"note\": \"End of day drawer count\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/pos/shift/close",
              "host": [
