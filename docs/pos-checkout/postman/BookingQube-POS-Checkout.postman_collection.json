          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pos/online-tickets/search?q={{onlineTicketSearch}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
