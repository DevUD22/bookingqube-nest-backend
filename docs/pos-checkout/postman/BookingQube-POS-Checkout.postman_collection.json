                  "  const tickets = d && d.tickets;",
                  "  if (Array.isArray(tickets) && tickets[0] && tickets[0].id) {",
                  "    pm.environment.set('onlineTicketId', tickets[0].id);",
                  "  }",
                  "} catch (e) {}"
                ]
              }
