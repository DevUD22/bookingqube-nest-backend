NODE_ENV=development
PORT=4000
API_PREFIX=api
API_VERSION=v2

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bookingqube
REDIS_URL=redis://localhost:6379

# Legacy Laravel MySQL — local
LEGACY_MYSQL_HOST=127.0.0.1
LEGACY_MYSQL_PORT=3306
LEGACY_MYSQL_USER=root
LEGACY_MYSQL_PASSWORD=
LEGACY_MYSQL_DATABASE=bookingqube

# Legacy Laravel MySQL — live / Azure (used when source=live)
LEGACY_MYSQL_LIVE_HOST=
LEGACY_MYSQL_LIVE_PORT=3306
LEGACY_MYSQL_LIVE_USER=
LEGACY_MYSQL_LIVE_PASSWORD=
LEGACY_MYSQL_LIVE_DATABASE=
LEGACY_MYSQL_LIVE_SSL=true

HOLD_EXPIRATION_WORKER_ENABLED=true
HOLD_EXPIRATION_INTERVAL_MS=30000

JWT_ACCESS_SECRET=change-me-customer-access
JWT_REFRESH_SECRET=change-me-customer-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
POS_JWT_ACCESS_SECRET=change-me-pos-access
POS_JWT_ACCESS_TTL=12h
CAFE_POS_JWT_ACCESS_SECRET=change-me-cafe-pos-access
CAFE_POS_JWT_ACCESS_TTL=12h
# Leave unset in production. Set ENABLE_SWAGGER=true only on trusted networks.
ENABLE_SWAGGER=

ADMIN_JWT_ACCESS_SECRET=change-me-admin-access
ADMIN_JWT_REFRESH_SECRET=change-me-admin-refresh
ADMIN_JWT_ACCESS_TTL=15m
ADMIN_JWT_REFRESH_TTL=7d

CORS_ORIGINS=http://localhost:3000,http://localhost:3001

GOOGLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_ID=

STORAGE_PROVIDER=azure_blob
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=
PUBLIC_MEDIA_BASE_URL=

MYFATOORAH_API_BASE_URL=
MYFATOORAH_API_KEY=
MYFATOORAH_COUNTRY_CODE=QA

# Local checkout only. Never enable in staging or production.
ENABLE_MOCK_PAYMENTS=false

SEATSIO_WORKSPACE_KEY=
SEATSIO_SECRET_KEY=
SEATSIO_REGION=

APP_PUBLIC_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:4000

# Development seed only. Always override outside local development.
SEED_ADMIN_PASSWORD=AdminPass123!
SEED_CUSTOMER_PASSWORD=CustomerPass123!
