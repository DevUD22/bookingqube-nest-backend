  checkedInAt          DateTime?        @map("checked_in_at")
  checkedInByUserId    String?          @map("checked_in_by_user_id") @db.Uuid
  seatsIoObjectId      String?          @map("seats_io_object_id")
  /// Report line snapshots
  visitorType          VisitorType      @default(paid) @map("visitor_type")
  thirdPartyVendorId   String?          @map("third_party_vendor_id") @db.Uuid
  admitCount           Int              @default(1) @map("admit_count")
  ticketIsCafe         Boolean          @default(false) @map("ticket_is_cafe")
  ticketIsPosOnly      Boolean          @default(false) @map("ticket_is_pos_only")
  ticketHideFromOnline Boolean          @default(false) @map("ticket_hide_from_online")
