  assignedBy User? @relation("CafeEventAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@index([cafeId, unassignedAt])
  @@index([eventId])
  @@index([assignedByUserId])
  @@map("cafe_event_assignments")
}

model CafeMenuCategory {
  id           String        @id @default(uuid()) @db.Uuid
  cafeId       String        @map("cafe_id") @db.Uuid
  titleEn      String        @map("title_en")
  titleAr      String?       @map("title_ar")
  imageMediaId String?       @map("image_media_id") @db.Uuid
  sortOrder    Int           @default(0) @map("sort_order")
  status       CatalogStatus @default(active)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  cafe          Cafe                  @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  imageMedia    MediaAsset?           @relation("CafeMenuCategoryImage", fields: [imageMediaId], references: [id], onDelete: SetNull)
  subcategories CafeMenuSubcategory[]

  @@index([cafeId, sortOrder])
  @@index([cafeId, status])
  @@index([imageMediaId])
  @@map("cafe_menu_categories")
}

model CafeMenuSubcategory {
  id           String        @id @default(uuid()) @db.Uuid
  categoryId   String        @map("category_id") @db.Uuid
  titleEn      String        @map("title_en")
  titleAr      String?       @map("title_ar")
  imageMediaId String?       @map("image_media_id") @db.Uuid
  isUngrouped  Boolean       @default(false) @map("is_ungrouped")
  sortOrder    Int           @default(0) @map("sort_order")
  status       CatalogStatus @default(active)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  category   CafeMenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  imageMedia MediaAsset?      @relation("CafeMenuSubcategoryImage", fields: [imageMediaId], references: [id], onDelete: SetNull)
  items      CafeMenuItem[]

  @@index([categoryId, sortOrder])
  @@index([categoryId, status])
  @@index([categoryId, isUngrouped])
  @@index([imageMediaId])
  @@map("cafe_menu_subcategories")
}

model CafeMenuItem {
  id            String        @id @default(uuid()) @db.Uuid
  subcategoryId String        @map("subcategory_id") @db.Uuid
  titleEn       String        @map("title_en")
  titleAr       String?       @map("title_ar")
  description   String?
  price         Decimal       @db.Decimal(12, 3)
  currency      String        @default("QAR")
  imageMediaId  String?       @map("image_media_id") @db.Uuid
  isKot         Boolean       @default(false) @map("is_kot")
  sortOrder     Int           @default(0) @map("sort_order")
  status        CatalogStatus @default(active)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  subcategory CafeMenuSubcategory   @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  imageMedia  MediaAsset?           @relation("CafeMenuItemImage", fields: [imageMediaId], references: [id], onDelete: SetNull)
  variants    CafeMenuItemVariant[]

  @@index([subcategoryId, sortOrder])
  @@index([subcategoryId, status])
  @@index([imageMediaId])
  @@map("cafe_menu_items")
}

/// Optional size / option rows for a cafe menu item (e.g. Small / Large).
model CafeMenuItemVariant {
  id        String        @id @default(uuid()) @db.Uuid
  itemId    String        @map("item_id") @db.Uuid
  titleEn   String        @map("title_en")
  titleAr   String?       @map("title_ar")
  price     Decimal       @db.Decimal(12, 3)
  sortOrder Int           @default(0) @map("sort_order")
  status    CatalogStatus @default(active)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  item CafeMenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, sortOrder])
  @@index([itemId, status])
  @@map("cafe_menu_item_variants")
}

model CafePosAgent {
  id        String                @id @default(uuid()) @db.Uuid
  cafeId    String                @map("cafe_id") @db.Uuid
  userId    String                @map("user_id") @db.Uuid
  status    StaffAssignmentStatus @default(active)
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")

  cafe Cafe @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cafeId, userId])
  @@index([userId, status])
  @@index([cafeId, status])
  @@map("cafe_pos_agents")
}

/// Per-agent end-of-day cash/card reconciliation (POS daily closing), scoped to one event.
model DailyClosing {
  id                 String             @id @default(uuid()) @db.Uuid
  closingCode        String             @map("closing_code")
  agentId            String             @map("agent_id") @db.Uuid
  eventId            String             @map("event_id") @db.Uuid
  organizationId     String?            @map("organization_id") @db.Uuid
  closingForDate     DateTime           @map("closing_for_date") @db.Date
  receivedCashAmount Decimal            @map("received_cash_amount") @db.Decimal(12, 3)
  receivedCardAmount Decimal            @map("received_card_amount") @db.Decimal(12, 3)
  totalCashSale      Decimal            @default(0) @map("total_cash_sale") @db.Decimal(12, 3)
  totalCardSale      Decimal            @default(0) @map("total_card_sale") @db.Decimal(12, 3)
  cashFlowBalance    Decimal            @default(0) @map("cash_flow_balance") @db.Decimal(12, 3)
  cardFlowBalance    Decimal            @default(0) @map("card_flow_balance") @db.Decimal(12, 3)
  qty                Int                @default(0)
  note               String?
  rejectReason       String?            @map("reject_reason")
  status             DailyClosingStatus @default(generated)
  signatureMediaId   String?            @map("signature_media_id") @db.Uuid
  signedPdfMediaId   String?            @map("signed_pdf_media_id") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")

  agent          User                        @relation("DailyClosingAgent", fields: [agentId], references: [id], onDelete: Cascade)
  event          Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organization   Organization?               @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  signatureMedia MediaAsset?                 @relation("DailyClosingSignature", fields: [signatureMediaId], references: [id], onDelete: SetNull)
  signedPdfMedia MediaAsset?                 @relation("DailyClosingSignedPdf", fields: [signedPdfMediaId], references: [id], onDelete: SetNull)
  statusHistory  DailyClosingStatusHistory[]

  @@index([agentId, closingForDate])
  @@index([eventId, closingForDate])
  @@index([closingForDate, status])
  @@index([organizationId, closingForDate])
  @@index([deletedAt])
  @@map("daily_closings")
}

model DailyClosingStatusHistory {
  id                 String             @id @default(uuid()) @db.Uuid
  dailyClosingId     String             @map("daily_closing_id") @db.Uuid
  closingCode        String             @map("closing_code")
  status             DailyClosingStatus
  cashFlowBalance    Decimal            @map("cash_flow_balance") @db.Decimal(12, 3)
  cardFlowBalance    Decimal            @map("card_flow_balance") @db.Decimal(12, 3)
  receivedCashAmount Decimal            @map("received_cash_amount") @db.Decimal(12, 3)
  receivedCardAmount Decimal            @map("received_card_amount") @db.Decimal(12, 3)
  totalCashSale      Decimal            @map("total_cash_sale") @db.Decimal(12, 3)
  totalCardSale      Decimal            @map("total_card_sale") @db.Decimal(12, 3)
  qty                Int                @default(0)
  note               String?
  rejectReason       String?            @map("reject_reason")
  actorId            String             @map("actor_id") @db.Uuid
  actorName          String             @map("actor_name")
  createdAt          DateTime           @default(now()) @map("created_at")

  dailyClosing DailyClosing @relation(fields: [dailyClosingId], references: [id], onDelete: Cascade)
  actor        User         @relation("DailyClosingHistoryActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([dailyClosingId, createdAt])
  @@map("daily_closing_status_histories")
}

model Settlement {
  id                    String           @id @default(uuid()) @db.Uuid
  settlementById        String           @map("settlement_by_id") @db.Uuid
  organizationId        String?          @map("organization_id") @db.Uuid
  settlementForDate     DateTime         @map("settlement_for_date") @db.Date
  receivedCashAmount    Decimal          @map("received_cash_amount") @db.Decimal(12, 3)
  receivedCardAmount    Decimal          @map("received_card_amount") @db.Decimal(12, 3)
  bookingCashSale       Decimal          @map("booking_cash_sale") @db.Decimal(12, 3)
  bookingCardSale       Decimal          @map("booking_card_sale") @db.Decimal(12, 3)
  discrepancyCashAmount Decimal          @map("discrepancy_cash_amount") @db.Decimal(12, 3)
  discrepancyCardAmount Decimal          @map("discrepancy_card_amount") @db.Decimal(12, 3)
  status                SettlementStatus @default(generated)
  signatureMediaId      String?          @map("signature_media_id") @db.Uuid
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  settlementBy   User          @relation("SettlementBy", fields: [settlementById], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  signatureMedia MediaAsset?   @relation("SettlementSignature", fields: [signatureMediaId], references: [id], onDelete: SetNull)

  // One settlement per day (shared by admin / finance manager).
  @@unique([settlementForDate])
  @@index([settlementForDate, status])
  @@index([organizationId, settlementForDate])
  @@map("settlements")
}

/// Open table cart for cafe POS (Phase 2). Settled rows become Orders on the assigned event.
model CafeOrder {
  id             String   @id @default(uuid()) @db.Uuid
  cafeId         String   @map("cafe_id") @db.Uuid
  eventId        String   @map("event_id") @db.Uuid
  agentUserId    String   @map("agent_user_id") @db.Uuid
  tableNumber    Int      @map("table_number")
  tokenNo        Int?     @map("token_no")
  paymentType    String   @map("payment_type") /// prepaid | postpaid
  status         String   @default("open") /// open | closed
  linesJson      Json     @map("lines_json")
  customerName   String?  @map("customer_name")
  customerEmail  String?  @map("customer_email")
  orderTotal     Decimal  @default(0) @map("order_total") @db.Decimal(12, 3)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 3)
  promoCodeId    String?  @map("promo_code_id") @db.Uuid
  promoCode      String?  @map("promo_code")
  currency       String   @default("QAR")
  commonOrder    String?  @map("common_order")
  settledOrderId String?  @map("settled_order_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  cafe  Cafe      @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  event Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  agent User      @relation("CafeOrderAgent", fields: [agentUserId], references: [id], onDelete: Cascade)
  promo PromoCode? @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)

  @@index([cafeId, eventId, status, tableNumber])
  @@index([agentUserId, status])
  @@index([eventId, status])
  @@index([promoCodeId])
  @@map("cafe_orders")
}

model ReviewSettings {
  id                       Int      @id @default(1)
  reviewsEnabled           Boolean  @default(true) @map("reviews_enabled")
  bookingFeedbackEnabled   Boolean  @default(true) @map("booking_feedback_enabled")
  requireCheckedIn         Boolean  @default(false) @map("require_checked_in")
  autoPublish              Boolean  @default(false) @map("auto_publish")
  allowComments            Boolean  @default(true) @map("allow_comments")
  showOnEventPages         Boolean  @default(true) @map("show_on_event_pages")
  showOnHomepageCards      Boolean  @default(false) @map("show_on_homepage_cards")
  minimumReviewCount       Int      @default(1) @map("minimum_review_count")
  defaultOpensAfterMinutes Int      @default(0) @map("default_opens_after_minutes")
  defaultClosesAfterDays   Int      @default(60) @map("default_closes_after_days")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("review_settings")
}

model EventReview {
  id               String       @id @default(uuid()) @db.Uuid
  eventId          String       @map("event_id") @db.Uuid
  customerId       String       @map("customer_id") @db.Uuid
  orderId          String       @unique @map("order_id") @db.Uuid
  rating           Int
  comment          String?
  status           ReviewStatus @default(pending)
  verifiedBooking  Boolean      @default(true) @map("verified_booking")
  verifiedAttendee Boolean      @default(false) @map("verified_attendee")
  moderatorNote    String?      @map("moderator_note")
  publishedAt      DateTime?    @map("published_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  event    Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  customer User  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([eventId, customerId])
  @@index([eventId, status, publishedAt])
  @@index([status, createdAt])
  @@map("event_reviews")
}

model BookingFeedback {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @unique @map("order_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  rating     Int
  tags       String[] @default([])
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer User  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("booking_feedback")
}
