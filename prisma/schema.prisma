generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  suspended
  deleted
}

enum AdminStatus {
  active
  suspended
}

enum OrganizationStatus {
  active
  suspended
  archived
}

enum OrganizationMemberRole {
  owner
  manager
  analyst
}

enum OrganizationMemberStatus {
  active
  suspended
}

enum StaffAssignmentStatus {
  active
  suspended
}

enum PublishStatus {
  draft
  review
  published
  archived
}

enum Visibility {
  public
  private
  unlisted
}

enum EventType {
  registration_only
  summer_camp
  general
}

enum BookingMode {
  ticketed
  registration
}

enum SessionStatus {
  active
  sold_out
  cancelled
  hidden
}

enum CatalogStatus {
  active
  hidden
  archived
}

enum InventoryItemType {
  ticket_type
  ticket_variant
  addon
  addon_variant
}

enum InventoryStatus {
  active
  paused
  sold_out
}

enum DateStatus {
  active
  cancelled
  hidden
}

enum MediaRole {
  hero
  gallery
  thumbnail
  homepage_banner
  homepage_banner_mobile
  event_poster
  ticket_side
}

enum StorageProvider {
  azure_blob
  s3
  local
}

enum AppSettingGroup {
  website
  social
  mail
  sms
  regional
  security
}

enum HoldStatus {
  active
  expired
  released
  converted
}

enum OrderStatus {
  pending_payment
  paid
  cancelled
  expired
  refunded
  partially_refunded
}

enum PaymentStatus {
  not_required
  pending
  paid
  failed
  refunded
  partially_refunded
}

enum PaymentMethodStatus {
  active
  inactive
}

enum PaymentProvider {
  internal
  myfatoorah
  mastercard
  qpay
}

enum PaymentGateway {
  myfatoorah
  mastercard
  qpay
}

enum PaymentGatewayEnvironment {
  sandbox
  live
}

enum PaymentTransactionStatus {
  pending
  paid
  failed
  cancelled
  refunded
  partially_refunded
}

/// Customer online checkout: payment succeeded (or started) but booking may not be confirmed.
enum CustomerPaymentRecoveryStatus {
  open
  resolved
  abandoned
}

enum CustomerPaymentRecoveryReason {
  awaiting_confirm
  payment_ok_booking_failed
  inventory_unavailable
  confirm_never_called
}

enum RefundStatus {
  pending
  succeeded
  failed
}

enum OrderItemType {
  ticket_type
  ticket_variant
  addon
  addon_variant
  customization
  cafe_item
}

/// Report classification for widget bifurcations (legacy DashboardReportHelper).
enum VisitorType {
  paid
  promocode
  comp
  special_need
  comp_promo
  third_party
  pos_only
}

/// Order-level payment mode for charts (no transactions join).
enum ReportPaymentMode {
  online
  offline_cash
  offline_card
  split
  advance
  comp
  free
}

/// Which calendar day a daily rollup row is keyed by (transaction vs event date).
enum ReportBasis {
  trx
  event
}

enum AdvancePaymentStatus {
  PENDING
  COMPLETED
  CANCELLED
  EXPIRED
}

enum PaymentLegType {
  cash
  card
  online_gateway
  comp
  other
}

enum AttendanceStatus {
  not_checked_in
  checked_in
  cancelled
}

enum PromoCodeStatus {
  draft
  active
  paused
  expired
}

enum DiscountType {
  percent
  fixed
}

enum DiscountApplication {
  per_ticket
  order_total
}

enum PromoTargetType {
  event
  ticket_type
  ticket_variant
  customer
  cafe
  cafe_menu_item
}

enum RateType {
  percent
  fixed
}

enum TaxApplicableOn {
  net_price
  net_price_with_addons
}

enum TaxType {
  exclusive
  inclusive
}

enum TaxStatus {
  active
  inactive
}

enum RegistrationFieldType {
  text
  email
  phone
  select
  checkbox
  file
  textarea
  number
  date
}

enum RegistrationSubmissionStatus {
  submitted
  cancelled
}

enum DailyClosingStatus {
  generated
  approved
  rejected
}

enum SettlementStatus {
  generated
  approved
  rejected
}

enum ReviewStatus {
  pending
  published
  rejected
  flagged
  archived
}

model HealthCheck {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("health_checks")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique @db.Citext
  username        String?    @unique @db.Citext
  phone           String?    @unique
  passwordHash    String?    @map("password_hash")
  name            String
  status          UserStatus @default(active)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  /// Requested address waiting for OTP confirmation. `email` stays unchanged until then.
  pendingEmail    String?    @map("pending_email") @db.Citext
  phoneVerifiedAt DateTime?  @map("phone_verified_at")
  lastLoginAt     DateTime?  @map("last_login_at")
  /// Apple `sub` from a verified identity token. Unique when present.
  appleSub        String?    @unique @map("apple_sub")
  /// Incremented on password change/reset so existing JWTs stop validating.
  tokenVersion    Int        @default(0) @map("token_version")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  customerProfile          CustomerProfile?
  adminProfile             AdminProfile?
  organizationMemberships  OrganizationMember[]
  uploadedMedia            MediaAsset[]                @relation("MediaUploadedBy")
  createdVenues            Venue[]                     @relation("VenueCreatedBy")
  updatedVenues            Venue[]                     @relation("VenueUpdatedBy")
  createdArtists           Artist[]                    @relation("ArtistCreatedBy")
  updatedArtists           Artist[]                    @relation("ArtistUpdatedBy")
  createdEvents            Event[]                     @relation("EventCreatedBy")
  updatedEvents            Event[]                     @relation("EventUpdatedBy")
  organizedEvents          Event[]                     @relation("EventPrimaryOrganizer")
  organizerAssignmentsMade Event[]                     @relation("EventOrganizerAssignedBy")
  authoredBlogs            Blog[]                      @relation("BlogAuthor")
  authoredOffers           Offer[]                     @relation("OfferAuthor")
  favoriteEvents           CustomerFavorite[]
  eventReviews             EventReview[]
  bookingFeedback          BookingFeedback[]
  ticketHolds              TicketHold[]
  orders                   Order[]
  bookedOrders             Order[]                     @relation("OrderBookedByAgent")
  bookedOrderItems         OrderItem[]                 @relation("OrderItemBookedByAgent")
  checkedInItems           OrderItem[]                 @relation("OrderItemCheckedInBy")
  createdRefunds           Refund[]                    @relation("RefundCreatedBy")
  collectedPayments        Payment[]                   @relation("PaymentCollectedBy")
  createdPromoCodes        PromoCode[]                 @relation("PromoCodeCreatedBy")
  updatedPromoCodes        PromoCode[]                 @relation("PromoCodeUpdatedBy")
  promoRedemptions         PromoCodeRedemption[]
  registrations            RegistrationSubmission[]
  staffAssignments         StaffAssignment[]
  managedStaffAssignments  StaffAssignment[]           @relation("StaffManagedBy")
  createdStaffAssignments  StaffAssignment[]           @relation("StaffCreatedBy")
  initiatedAdvancePayments AdvancePayment[]            @relation("AdvanceInitiatedBy")
  completedAdvancePayments AdvancePayment[]            @relation("AdvanceCompletedBy")
  managedCafes             Cafe[]                      @relation("CafeManagedBy")
  cafePosAgents            CafePosAgent[]
  cafeEventAssignments     CafeEventAssignment[]       @relation("CafeEventAssignedBy")
  cafeOrdersAsAgent        CafeOrder[]                 @relation("CafeOrderAgent")
  dailyClosingsAsAgent     DailyClosing[]              @relation("DailyClosingAgent")
  dailyClosingHistoryActs  DailyClosingStatusHistory[] @relation("DailyClosingHistoryActor")
  settlementsCreated       Settlement[]                @relation("SettlementBy")
  paymentRecoveries        CustomerPaymentRecovery[]
  emailChangeOtps          EmailChangeOtp[]
  customerSessions         CustomerSession[]

  @@index([status])
  @@map("users")
}

model PasswordResetOtp {
  id         String    @id @default(uuid()) @db.Uuid
  email      String    @db.Citext
  otpHash    String    @map("otp_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email, consumedAt, expiresAt])
  @@map("password_reset_otps")
}

model EmailChangeOtp {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  newEmail   String    @map("new_email") @db.Citext
  otpHash    String    @map("otp_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt, expiresAt])
  @@map("email_change_otps")
}

model CustomerSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime? @map("last_used_at")
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("customer_sessions")
}

model CustomerProfile {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  avatarMediaId String?  @map("avatar_media_id") @db.Uuid
  address       String?
  ageGroup      String?  @map("age_group")
  nationality   String?
  defaultLocale String   @default("en") @map("default_locale")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarMedia MediaAsset? @relation("CustomerAvatar", fields: [avatarMediaId], references: [id])

  @@map("customer_profiles")
}

model CustomerFavorite {
  customerId String   @map("customer_id") @db.Uuid
  eventId    String   @map("event_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  customer User  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  event    Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([customerId, eventId])
  @@index([eventId])
  @@index([customerId, createdAt])
  @@map("customer_favorites")
}

model AdminProfile {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @unique @map("user_id") @db.Uuid
  roleId        String      @map("role_id") @db.Uuid
  status        AdminStatus @default(active)
  avatarMediaId String?     @map("avatar_media_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role        @relation(fields: [roleId], references: [id])
  avatarMedia MediaAsset? @relation("AdminAvatar", fields: [avatarMediaId], references: [id])
  sessions    AdminSession[]

  @@map("admin_profiles")
}

model AdminSession {
  id             String    @id @default(uuid()) @db.Uuid
  adminProfileId String    @map("admin_profile_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  lastUsedAt     DateTime? @map("last_used_at")
  userAgent      String?   @map("user_agent")
  ipAddress      String?   @map("ip_address")
  createdAt      DateTime  @default(now()) @map("created_at")

  adminProfile AdminProfile @relation(fields: [adminProfileId], references: [id], onDelete: Cascade)

  @@index([adminProfileId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  slug      String             @unique
  name      String
  status    OrganizationStatus @default(active)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  members          OrganizationMember[]
  events           Event[]
  promoCodes       PromoCode[]
  orders           Order[]
  staffAssignments StaffAssignment[]
  advancePayments  AdvancePayment[]
  cafes            Cafe[]
  dailyClosings    DailyClosing[]
  settlements      Settlement[]

  @@index([status, name])
  @@map("organizations")
}

model OrganizationMember {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  userId         String                   @map("user_id") @db.Uuid
  role           OrganizationMemberRole   @default(manager)
  status         OrganizationMemberStatus @default(active)
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions     OrganizerSession[]

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status])
  @@map("organization_members")
}

model OrganizerSession {
  id                   String    @id @default(uuid()) @db.Uuid
  organizationMemberId String    @map("organization_member_id") @db.Uuid
  tokenHash            String    @unique @map("token_hash")
  expiresAt            DateTime  @map("expires_at")
  revokedAt            DateTime? @map("revoked_at")
  lastUsedAt           DateTime? @map("last_used_at")
  userAgent            String?   @map("user_agent")
  ipAddress            String?   @map("ip_address")
  createdAt            DateTime  @default(now()) @map("created_at")

  organizationMember OrganizationMember @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)

  @@index([organizationMemberId, revokedAt, expiresAt])
  @@index([expiresAt])
  @@map("organizer_sessions")
}

model Role {
  id                      String   @id @default(uuid()) @db.Uuid
  name                    String   @unique
  description             String?
  /// When true, event staff with this role must be attached to a third-party vendor
  /// and reports / ticket management are scoped to that vendor's tickets only.
  isThirdPartyShareholder Boolean  @default(false) @map("is_third_party_shareholder")
  createdAt               DateTime @default(now()) @map("created_at")

  admins           AdminProfile[]
  permissions      RolePermission[]
  staffAssignments StaffAssignment[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Scoped staff placement: org + optional event / ThirdPartyVendor / tickets.
/// POS: one active row per user per event. EM: requires thirdPartyVendorId (single vendor).
/// POS may scope multiple ThirdPartyVendors via thirdPartyVendorIds + ticketTypeIds.
model StaffAssignment {
  id                  String                @id @default(uuid()) @db.Uuid
  userId              String                @map("user_id") @db.Uuid
  roleId              String                @map("role_id") @db.Uuid
  organizationId      String                @map("organization_id") @db.Uuid
  eventId             String?               @map("event_id") @db.Uuid
  /// Single vendor for event_manager (and legacy POS).
  thirdPartyVendorId  String?               @map("third_party_vendor_id") @db.Uuid
  /// Multi-vendor scope for POS agents.
  thirdPartyVendorIds String[]              @default([]) @map("third_party_vendor_ids") @db.Uuid
  /// Who owns this agent in the hierarchy (organiser or event_manager).
  managedByUserId     String?               @map("managed_by_user_id") @db.Uuid
  /// Audit: platform admin / manager who created the row.
  createdByUserId     String?               @map("created_by_user_id") @db.Uuid
  /// Empty = all tickets in selected vendors / event.
  ticketTypeIds       String[]              @default([]) @map("ticket_type_ids") @db.Uuid
  isCafeAgent         Boolean               @default(false) @map("is_cafe_agent")
  status              StaffAssignmentStatus @default(active)
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             Role              @relation(fields: [roleId], references: [id])
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event            Event?            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  thirdPartyVendor ThirdPartyVendor? @relation(fields: [thirdPartyVendorId], references: [id], onDelete: SetNull)
  managedBy        User?             @relation("StaffManagedBy", fields: [managedByUserId], references: [id], onDelete: SetNull)
  createdBy        User?             @relation("StaffCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([organizationId, status])
  @@index([eventId, status])
  @@index([roleId, status])
  @@index([thirdPartyVendorId])
  @@index([managedByUserId, status])
  @@map("staff_assignments")
}

model MediaAsset {
  id               String          @id @default(uuid()) @db.Uuid
  storageProvider  StorageProvider @map("storage_provider")
  bucket           String
  storageKey       String          @map("storage_key")
  url              String
  mimeType         String          @map("mime_type")
  sizeBytes        BigInt?         @map("size_bytes")
  width            Int?
  height           Int?
  altText          String?         @map("alt_text")
  uploadedByUserId String?         @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  uploadedBy             User?                         @relation("MediaUploadedBy", fields: [uploadedByUserId], references: [id])
  customerAvatars        CustomerProfile[]             @relation("CustomerAvatar")
  adminAvatars           AdminProfile[]                @relation("AdminAvatar")
  venueHeroes            Venue[]                       @relation("VenueHeroMedia")
  artistProfiles         Artist[]                      @relation("ArtistProfileMedia")
  artistBanners          Artist[]                      @relation("ArtistBannerMedia")
  eventPrimaryFor        Event[]                       @relation("EventPrimaryMedia")
  eventMedia             EventMedia[]
  blogHeroes             Blog[]                        @relation("BlogHeroMedia")
  offerHeroes            Offer[]                       @relation("OfferHeroMedia")
  registrationValues     RegistrationSubmissionValue[]
  cafeMenuItems          CafeMenuItem[]                @relation("CafeMenuItemImage")
  cafeMenuCategories     CafeMenuCategory[]            @relation("CafeMenuCategoryImage")
  cafeMenuSubcategories  CafeMenuSubcategory[]         @relation("CafeMenuSubcategoryImage")
  dailyClosingSignatures DailyClosing[]                @relation("DailyClosingSignature")
  dailyClosingSignedPdfs DailyClosing[]                @relation("DailyClosingSignedPdf")
  settlementSignatures   Settlement[]                  @relation("SettlementSignature")

  @@index([storageKey])
  @@index([createdAt])
  @@map("media_assets")
}

model Venue {
  id              String        @id @default(uuid()) @db.Uuid
  slug            String        @unique
  name            String
  status          PublishStatus @default(draft)
  address         String?
  city            String?
  state           String?
  zipcode         String?
  country         String        @default("QA")
  latitude        Decimal?      @db.Decimal(10, 7)
  longitude       Decimal?      @db.Decimal(10, 7)
  googleMapUrl    String?       @map("google_map_url")
  bannerUrl       String?       @map("banner_url")
  galleryUrls     Json?         @map("gallery_urls")
  heroMediaId     String?       @map("hero_media_id") @db.Uuid
  createdByUserId String?       @map("created_by_user_id") @db.Uuid
  updatedByUserId String?       @map("updated_by_user_id") @db.Uuid
  publishedAt     DateTime?     @map("published_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  heroMedia       MediaAsset?        @relation("VenueHeroMedia", fields: [heroMediaId], references: [id])
  createdBy       User?              @relation("VenueCreatedBy", fields: [createdByUserId], references: [id])
  updatedBy       User?              @relation("VenueUpdatedBy", fields: [updatedByUserId], references: [id])
  translations    VenueTranslation[]
  events          Event[]
  orders          Order[]
  advancePayments AdvancePayment[]

  @@index([status])
  @@map("venues")
}

model VenueTranslation {
  id          String  @id @default(uuid()) @db.Uuid
  venueId     String  @map("venue_id") @db.Uuid
  locale      String
  name        String
  description String?
  address     String?
  city        String?
  state       String?
  country     String?

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, locale])
  @@map("venue_translations")
}

model Artist {
  id                 String        @id @default(uuid()) @db.Uuid
  slug               String        @unique
  name               String
  status             PublishStatus @default(draft)
  stageName          String?       @map("stage_name")
  dateOfBirth        DateTime?     @map("date_of_birth") @db.Date
  age                Int?
  ageIsManual        Boolean       @default(false) @map("age_is_manual")
  origin             String?
  heightCm           Int?          @map("height_cm")
  ethnicity          String?
  nationality        String?
  religion           String?
  occupation         String?
  genres             String?
  instruments        String?
  netWorth           Decimal?      @map("net_worth") @db.Decimal(15, 2)
  netWorthCurrency   String        @default("USD") @map("net_worth_currency") @db.VarChar(3)
  maritalStatus      String?       @map("marital_status") @db.VarChar(32)
  spouseName         String?       @map("spouse_name")
  children           Json?
  parents            Json?
  profileUpdatedDate DateTime?     @map("profile_updated_date") @db.Date
  profileMediaId     String?       @map("profile_media_id") @db.Uuid
  bannerMediaId      String?       @map("banner_media_id") @db.Uuid
  createdByUserId    String?       @map("created_by_user_id") @db.Uuid
  updatedByUserId    String?       @map("updated_by_user_id") @db.Uuid
  publishedAt        DateTime?     @map("published_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  profileMedia MediaAsset?         @relation("ArtistProfileMedia", fields: [profileMediaId], references: [id])
  bannerMedia  MediaAsset?         @relation("ArtistBannerMedia", fields: [bannerMediaId], references: [id])
  createdBy    User?               @relation("ArtistCreatedBy", fields: [createdByUserId], references: [id])
  updatedBy    User?               @relation("ArtistUpdatedBy", fields: [updatedByUserId], references: [id])
  translations ArtistTranslation[]
  events       EventArtist[]

  @@index([status])
  @@map("artists")
}

model ArtistTranslation {
  id       String  @id @default(uuid()) @db.Uuid
  artistId String  @map("artist_id") @db.Uuid
  locale   String
  name     String
  subtitle String?
  bio      String?

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([artistId, locale])
  @@map("artist_translations")
}

model EventCategory {
  id           String        @id @default(uuid()) @db.Uuid
  slug         String        @unique
  name         String
  status       CatalogStatus @default(active)
  sortOrder    Int           @default(0) @map("sort_order")
  parentId     String?       @map("parent_id") @db.Uuid
  thumbnailUrl String?       @map("thumbnail_url")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  parent       EventCategory?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     EventCategory[]            @relation("CategoryTree")
  events       Event[]
  translations EventCategoryTranslation[]

  @@index([status, sortOrder])
  @@index([parentId])
  @@map("event_categories")
}

model EventCategoryTranslation {
  id         String @id @default(uuid()) @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  locale     String
  name       String

  category EventCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@map("event_category_translations")
}

model Event {
  id                        String        @id @default(uuid()) @db.Uuid
  organizationId            String        @map("organization_id") @db.Uuid
  slug                      String        @unique
  eventType                 EventType     @map("event_type")
  status                    PublishStatus @default(draft)
  visibility                Visibility    @default(public)
  /// Plain-text gate password for private events (V2 Next.js unlock). Null = no password gate.
  gatePassword              String?       @map("gate_password")
  venueId                   String?       @map("venue_id") @db.Uuid
  primaryMediaId            String?       @map("primary_media_id") @db.Uuid
  categoryId                String?       @map("category_id") @db.Uuid
  requiresWaiver            Boolean       @default(false) @map("requires_waiver")
  /// When true, event appears in public featuredEvents / homepage featured sections.
  isFeatured                Boolean       @default(false) @map("is_featured")
  bookingMode               BookingMode   @map("booking_mode")
  seatSelectionEnabled      Boolean       @default(false) @map("seat_selection_enabled")
  seatsIoEventKey           String?       @map("seats_io_event_key")
  seatsIoChartKey           String?       @map("seats_io_chart_key")
  currency                  String        @default("QAR")
  startsAt                  DateTime?     @map("starts_at")
  endsAt                    DateTime?     @map("ends_at")
  /// Enhanced schedule pattern (preferred / daily weekday-weekend / monthly / custom). Sessions are materialised into event_dates + event_sessions.
  timingConfig              Json?         @map("timing_config")
  /// Optional ops extras (entry_access code pool, POS passwords, feedback, bulk booking, time extensions). Kept off the order reporting path.
  moreOpsConfig             Json?         @map("more_ops_config")
  publishedAt               DateTime?     @map("published_at")
  createdByUserId           String?       @map("created_by_user_id") @db.Uuid
  updatedByUserId           String?       @map("updated_by_user_id") @db.Uuid
  primaryOrganizerId        String?       @map("primary_organizer_id") @db.Uuid
  organizerAssignedByUserId String?       @map("organizer_assigned_by_user_id") @db.Uuid
  organizerAssignedAt       DateTime?     @map("organizer_assigned_at")
  createdAt                 DateTime      @default(now()) @map("created_at")
  updatedAt                 DateTime      @updatedAt @map("updated_at")
  reviewsEnabled            Boolean?      @map("reviews_enabled")
  reviewOpensAfterMinutes   Int?          @map("review_opens_after_minutes")
  reviewClosesAfterDays     Int?          @map("review_closes_after_days")

  organization                Organization                         @relation(fields: [organizationId], references: [id])
  venue                       Venue?                               @relation(fields: [venueId], references: [id])
  primaryMedia                MediaAsset?                          @relation("EventPrimaryMedia", fields: [primaryMediaId], references: [id])
  category                    EventCategory?                       @relation(fields: [categoryId], references: [id])
  createdBy                   User?                                @relation("EventCreatedBy", fields: [createdByUserId], references: [id])
  updatedBy                   User?                                @relation("EventUpdatedBy", fields: [updatedByUserId], references: [id])
  primaryOrganizer            User?                                @relation("EventPrimaryOrganizer", fields: [primaryOrganizerId], references: [id], onDelete: SetNull)
  organizerAssignedBy         User?                                @relation("EventOrganizerAssignedBy", fields: [organizerAssignedByUserId], references: [id], onDelete: SetNull)
  translations                EventTranslation[]
  dates                       EventDate[]
  sessions                    EventSession[]
  artists                     EventArtist[]
  media                       EventMedia[]
  ticketGroups                TicketGroup[]
  ticketTypes                 TicketType[]
  thirdPartyVendors           ThirdPartyVendor[]
  thirdPartyPlatforms         ThirdPartyPlatform[]
  addons                      Addon[]
  inventoryItems              InventoryItem[]
  favoriteEntries             CustomerFavorite[]
  ticketHolds                 TicketHold[]
  orders                      Order[]
  orderItems                  OrderItem[]
  taxes                       Tax[]
  registrationForms           RegistrationForm[]
  registrationSubmissions     RegistrationSubmission[]
  staffAssignments            StaffAssignment[]
  offerEntries                OfferEvent[]
  salesCounters               EventSalesCounter[]
  attendanceCounters          EventAttendanceCounter[]
  reportDaily                 BookingReportDaily[]
  reportPaymentDaily          BookingReportPaymentDaily[]
  reportVisitorDaily          BookingReportVisitorDaily[]
  reportPosDaily              BookingReportPosDaily[]
  reportThirdPartyVendorDaily BookingReportThirdPartyVendorDaily[]
  reportTicketDaily           BookingReportTicketDaily[]
  reportVendorProductDaily    BookingReportVendorProductDaily[]
  reportDemoDaily             BookingReportDemoDaily[]
  reportCafeDaily             BookingReportCafeDaily[]
  reportCafeAgentDaily        BookingReportCafeAgentDaily[]
  reportCafeItemDaily         BookingReportCafeItemDaily[]
  reportNamedExtraDaily       BookingReportNamedExtraDaily[]
  advancePayments             AdvancePayment[]
  activeCafes                 Cafe[]                               @relation("CafeActiveEvent")
  cafeEventAssignments        CafeEventAssignment[]
  cafeOrders                  CafeOrder[]
  dailyClosings               DailyClosing[]
  reviews                     EventReview[]
  paymentRecoveries           CustomerPaymentRecovery[]

  @@index([status, startsAt])
  @@index([organizationId, status, startsAt])
  @@index([primaryOrganizerId, status, startsAt])
  @@index([eventType, status])
  @@index([categoryId, status, startsAt])
  @@index([venueId])
  @@index([seatsIoEventKey])
  @@index([isFeatured, status, startsAt])
  @@map("events")
}

/// Per-event third-party vendor revenue split (legacy organiser groups). Name is unique within the event.
model ThirdPartyVendor {
  id                  String   @id @default(uuid()) @db.Uuid
  eventId             String   @map("event_id") @db.Uuid
  name                String
  isMain              Boolean  @default(false) @map("is_main")
  organiserShare      Decimal  @map("organiser_share") @db.Decimal(5, 2)
  vendorSharePct      Decimal  @map("vendor_share_pct") @db.Decimal(5, 2)
  isCafe              Boolean  @default(false) @map("is_cafe")
  collectedBy         String?  @map("collected_by")
  ownerName           String?  @map("owner_name")
  ownerPercentageType String?  @map("owner_percentage_type")
  sortOrder           Int      @default(0) @map("sort_order")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  event                       Event                                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketTypes                 TicketType[]
  orderItems                  OrderItem[]
  staffAssignments            StaffAssignment[]
  reportThirdPartyVendorDaily BookingReportThirdPartyVendorDaily[]
  reportVendorProductDaily    BookingReportVendorProductDaily[]

  @@unique([eventId, name])
  @@index([eventId, sortOrder])
  @@map("third_party_vendors")
}

/// Per-event external booking platform (e.g. E3). Separate from third-party vendors (shareholders).
/// Optional accessCode is for future partner API auth — not POS/checkout gating.
model ThirdPartyPlatform {
  id         String   @id @default(uuid()) @db.Uuid
  eventId    String   @map("event_id") @db.Uuid
  name       String
  accessCode String?  @map("access_code")
  badgeColor String   @default("#F1E9FF") @map("badge_color")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketTypes TicketType[]

  @@unique([eventId, name])
  @@index([eventId, sortOrder])
  @@map("third_party_platforms")
}

model EventTranslation {
  id              String  @id @default(uuid()) @db.Uuid
  eventId         String  @map("event_id") @db.Uuid
