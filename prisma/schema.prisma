  @@index([provider, providerPaymentId])
  @@index([provider, providerInvoiceId])
  @@index([status, createdAt])
  @@index([paidAt])
  @@index([legType])
  @@index([collectedByUserId, paidAt])
  @@map("payments")
}

model Refund {
