model Order {
  id               String        @id @default(uuid()) @db.Uuid
  commonOrder      String        @unique @map("common_order")
  idempotencyKey   String        @unique @map("idempotency_key")
  customerId       String        @map("customer_id") @db.Uuid
  eventId          String        @map("event_id") @db.Uuid
  eventSessionId   String        @map("event_session_id") @db.Uuid
  holdId           String?       @map("hold_id") @db.Uuid
  status           OrderStatus   @default(pending_payment)
  paymentStatus    PaymentStatus @default(pending) @map("payment_status")
  currency         String        @default("QAR")
  subtotalAmount   Decimal       @map("subtotal_amount") @db.Decimal(12, 3)
  discountAmount   Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 3)
  taxAmount        Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 3)
  totalAmount      Decimal       @map("total_amount") @db.Decimal(12, 3)
  promoCodeId      String?       @map("promo_code_id") @db.Uuid
  promoCode        String?       @map("promo_code")
  source           String        @default("web")
  locale           String        @default("en")
  waiverAccepted   Boolean       @default(false) @map("waiver_accepted")
  waiverSignedBy   String?       @map("waiver_signed_by")
  waiverAcceptedAt DateTime?     @map("waiver_accepted_at")
  metadata         Json?
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  paidAt           DateTime?     @map("paid_at")
  cancelledAt      DateTime?     @map("cancelled_at")

  /// Report snapshots (Reporting v2 — avoid joins on dashboard reads)
  organizationId           String            @map("organization_id") @db.Uuid
  venueId                  String?           @map("venue_id") @db.Uuid
  eventSlug                String            @map("event_slug")
  eventTitle               String            @map("event_title")
  eventStartDate           DateTime?         @map("event_start_date") @db.Date
  eventStartTime           String?           @map("event_start_time")
  customerName             String            @map("customer_name")
  customerEmail            String            @map("customer_email") @db.Citext
  customerPhone            String?           @map("customer_phone")
  customerAgeGroup         String?           @map("customer_age_group")
  customerGeographicRegion String?           @map("customer_geographic_region")
  customerGender           String?           @map("customer_gender")
  paymentMode              ReportPaymentMode @default(online) @map("payment_mode")
  paymentMethodLabel       String            @default("Online") @map("payment_method_label")
  /// Denormalized tender amounts for POS / split / advance report scans (no payments join).
  cashAmount               Decimal           @default(0) @map("cash_amount") @db.Decimal(12, 3)
  cardAmount               Decimal           @default(0) @map("card_amount") @db.Decimal(12, 3)
  onlineAmount             Decimal           @default(0) @map("online_amount") @db.Decimal(12, 3)
  compAmount               Decimal           @default(0) @map("comp_amount") @db.Decimal(12, 3)
  /// POS agent who booked this order (report / closing key).
  bookedByAgentId          String?           @map("booked_by_agent_id") @db.Uuid
  ticketsNet               Decimal           @default(0) @map("tickets_net") @db.Decimal(12, 3)
  addonsNet                Decimal           @default(0) @map("addons_net") @db.Decimal(12, 3)
  extensionsNet            Decimal           @default(0) @map("extensions_net") @db.Decimal(12, 3)
  totalQuantity            Int               @default(0) @map("total_quantity")
  totalAdmits              Int               @default(0) @map("total_admits")
  isSummerCamp             Boolean           @default(false) @map("is_summer_camp")
  reportVersion            Int               @default(1) @map("report_version")
  reportSyncPending        Boolean           @default(false) @map("report_sync_pending")

  customer         User                     @relation(fields: [customerId], references: [id])
  bookedByAgent    User?                    @relation("OrderBookedByAgent", fields: [bookedByAgentId], references: [id], onDelete: SetNull)
  event            Event                    @relation(fields: [eventId], references: [id])
  eventSession     EventSession             @relation(fields: [eventSessionId], references: [id])
  organization     Organization             @relation(fields: [organizationId], references: [id])
  venue            Venue?                   @relation(fields: [venueId], references: [id])
  hold             TicketHold?              @relation(fields: [holdId], references: [id])
  promo            PromoCode?               @relation(fields: [promoCodeId], references: [id])
  items            OrderItem[]
  payments         Payment[]
  refunds          Refund[]
  promoRedemptions PromoCodeRedemption[]
  taxLines         OrderTaxLine[]
  registrations    RegistrationSubmission[]
  reportLedger     OrderReportLedger[]
  eventReview      EventReview?
  bookingFeedback  BookingFeedback?
  paymentRecoveries CustomerPaymentRecovery[]

  @@index([customerId, createdAt])
  @@index([eventId, createdAt])
  @@index([eventSessionId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([commonOrder])
  @@index([idempotencyKey])
  @@index([paidAt])
  @@index([organizationId, eventStartDate])
  @@index([organizationId, createdAt])
  @@index([eventId, status, createdAt])
  @@index([eventId, paymentMode])
  @@index([venueId, createdAt])
  @@index([reportSyncPending])
  @@index([bookedByAgentId, paidAt])
  @@index([eventId, bookedByAgentId, paidAt])
  @@index([organizationId, paymentMode, paidAt])
  @@map("orders")
}

model OrderItem {
  id                   String           @id @default(uuid()) @db.Uuid
