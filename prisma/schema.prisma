  event                Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketGroup          TicketGroup?                @relation(fields: [ticketGroupId], references: [id])
  thirdPartyVendor     ThirdPartyVendor?           @relation(fields: [thirdPartyVendorId], references: [id], onDelete: SetNull)
  thirdPartyPlatform   ThirdPartyPlatform?         @relation(fields: [thirdPartyPlatformId], references: [id], onDelete: SetNull)
  variants             TicketVariant[]
  customizationOptions TicketCustomizationOption[]

  @@unique([eventId, externalKey])
  @@index([eventId, status, sortOrder])
