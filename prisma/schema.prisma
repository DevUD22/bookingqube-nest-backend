  thirdPartyPlatformId         String?       @map("third_party_platform_id") @db.Uuid
  externalKey                  String        @map("external_key")
  title                        String
  subtitle                     String?
  inclusions                   String[]      @default([])
  exclusions                   String[]      @default([])
  iconType                     String?       @map("icon_type")
  hasVariants                  Boolean       @default(false) @map("has_variants")
  isCustomizable               Boolean       @default(false) @map("is_customizable")
  basePrice                    Decimal?      @map("base_price") @db.Decimal(12, 3)
  currency                     String        @default("QAR")
  admitCount                   Int           @default(1) @map("admit_count")
