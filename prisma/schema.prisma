  bookedByAgentId      String?          @map("booked_by_agent_id") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event            Event             @relation(fields: [eventId], references: [id])
  eventSession     EventSession      @relation(fields: [eventSessionId], references: [id])
  inventoryItem    InventoryItem?    @relation(fields: [inventoryItemId], references: [id])
  thirdPartyVendor ThirdPartyVendor? @relation(fields: [thirdPartyVendorId], references: [id], onDelete: SetNull)
  bookedByAgent    User?             @relation("OrderItemBookedByAgent", fields: [bookedByAgentId], references: [id], onDelete: SetNull)
  parentOrderItem  OrderItem?        @relation("OrderItemChildren", fields: [parentOrderItemId], references: [id])
  childItems       OrderItem[]       @relation("OrderItemChildren")
  checkedInBy      User?             @relation("OrderItemCheckedInBy", fields: [checkedInByUserId], references: [id])

  @@index([orderId])
  @@index([eventId, eventSessionId])
  @@index([ticketCode])
  @@index([rfidCodes], type: Gin)
  @@index([attendanceStatus, checkedInAt])
  @@index([seatsIoObjectId])
  @@index([eventId, visitorType])
  @@index([thirdPartyVendorId])
  @@index([eventId, thirdPartyVendorId])
  @@index([bookedByAgentId, createdAt])
  @@index([eventId, bookedByAgentId])
  @@map("order_items")
}

model Payment {
  id                      String                   @id @default(uuid()) @db.Uuid
  orderId                 String                   @map("order_id") @db.Uuid
  provider                PaymentProvider          @default(myfatoorah)
  providerPaymentMethodId Int?                     @map("provider_payment_method_id")
  methodKey               String                   @map("method_key")
  legType                 PaymentLegType           @default(online_gateway) @map("leg_type")
  status                  PaymentTransactionStatus @default(pending)
  amount                  Decimal                  @db.Decimal(12, 3)
  currency                String                   @default("QAR")
  providerInvoiceId       String?                  @map("provider_invoice_id")
  providerPaymentId       String?                  @map("provider_payment_id")
  providerSessionId       String?                  @map("provider_session_id")
  providerResponse        Json?                    @map("provider_response")
  failureCode             String?                  @map("failure_code")
  failureMessage          String?                  @map("failure_message")
  collectedByUserId       String?                  @map("collected_by_user_id") @db.Uuid
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  paidAt                  DateTime?                @map("paid_at")
  failedAt                DateTime?                @map("failed_at")

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  collectedBy User?    @relation("PaymentCollectedBy", fields: [collectedByUserId], references: [id], onDelete: SetNull)
  refunds     Refund[]

  @@index([orderId])
