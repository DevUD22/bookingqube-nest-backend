{
  "name": "bookingqube-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Clean BookingQube backend built with NestJS, Fastify, PostgreSQL, Prisma, and Redis.",
  "scripts": {
    "build": "nest build",
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed-review-demo": "tsx prisma/seed-review-demo.ts",
    "prisma:backfill-admin-profiles": "tsx --env-file=.env scripts/backfill-admin-profiles.ts",
    "prisma:seed-vendor-demo": "tsx prisma/seed-vendor-sales-demo.ts",
    "prisma:seed-sample-pos": "tsx prisma/seed-sample-pos-agent.ts",
    "prisma:seed-cafe-pos-demo": "tsx prisma/seed-cafe-pos-demo.ts",
    "prisma:seed-open-rfid": "tsx prisma/seed-open-rfid-pos.ts",
    "prisma:seed-online-non-rfid": "tsx prisma/seed-online-non-rfid-pos.ts",
    "prisma:seed-insights": "tsx prisma/seed-event-insights-repeat-customers.ts",
    "prisma:seed-perf-orders-50k": "tsx prisma/seed-perf-orders-50k.ts",
    "prisma:sync-perf-order-rollups": "tsx prisma/sync-perf-order-rollups.ts",
    "prisma:backfill-customization-vendor-share": "tsx --env-file=.env prisma/backfill-customization-vendor-share.ts",
    "prisma:destroy-perf-orders-50k": "tsx prisma/destroy-perf-orders-50k.ts",
    "prisma:backfill-report-snapshots": "tsx prisma/backfill-order-report-snapshots.ts",
    "legacy:list": "tsx --env-file=.env scripts/legacy-migration/cli.ts list",
    "legacy:inspect": "tsx --env-file=.env scripts/legacy-migration/cli.ts inspect",
    "legacy:migrate": "tsx --env-file=.env scripts/legacy-migration/cli.ts migrate",
    "legacy:verify": "tsx --env-file=.env scripts/legacy-migration/cli.ts verify"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.33.0",
    "@fastify/helmet": "^11.1.1",
    "@nestjs/common": "10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "10.4.22",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "10.4.22",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.1.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.34.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "google-auth-library": "^10.9.0",
    "ioredis": "^5.4.2",
    "jose": "^4.15.9",
    "mysql2": "^3.23.1",
    "nodemailer": "^9.0.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "10.4.22",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.10",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
